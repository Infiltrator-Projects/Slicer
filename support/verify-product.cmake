get_filename_component(repo_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${repo_root}/support/version.inc")
file(READ "${repo_root}/support/VERSION" release_version)
string(STRIP "${release_version}" release_version)
if(NOT SLIC3R_APP_NAME STREQUAL "Slicer" OR NOT SLIC3R_APP_KEY STREQUAL "Slicer")
    message(FATAL_ERROR "Product identity must be Slicer / Slicer.")
endif()
if(NOT release_version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$" OR
   NOT SLIC3R_VERSION STREQUAL release_version)
    message(FATAL_ERROR "Product and release versions must match support/VERSION.")
endif()
if(NOT SLIC3R_BUILD_ID STREQUAL "Slicer-${release_version}")
    message(FATAL_ERROR "Build identity must use the repository-owned product version.")
endif()
string(REPLACE "." "," expected_rc_version "${release_version}.0")
if(NOT SLIC3R_RC_VERSION STREQUAL expected_rc_version OR
   NOT SLIC3R_RC_VERSION_DOTS STREQUAL "${release_version}.0")
    message(FATAL_ERROR "Windows resource versions differ from the product version.")
endif()
if(NOT SLIC3R_COMPATIBILITY_VERSION STREQUAL "2.9.6")
    message(FATAL_ERROR "Retain the inherited engine's printer-profile/schema compatibility version.")
endif()

# Keep the product's About page and startup splash free of inherited developer
# roll calls. Their copyright notices remain in the separate legal-notices dialog.
file(READ "${repo_root}/src/slic3r/GUI/AboutDialog.cpp" about_source)
string(FIND "${about_source}" "AboutDialog::AboutDialog()" about_start)
if(about_start LESS 0)
    message(FATAL_ERROR "Cannot find the product About dialog.")
endif()
string(SUBSTRING "${about_source}" ${about_start} -1 about_product)
file(READ "${repo_root}/src/slic3r/GUI/GUI_App.cpp" app_source)
string(REGEX MATCH "credits =[^;]*;" splash_credits "${app_source}")
if(NOT splash_credits)
    message(FATAL_ERROR "Cannot find the product startup credits.")
endif()
set(product_credits "${about_product}\n${splash_credits}")
if(product_credits MATCHES "contributors_str|Contributions by|Prusa Research|Alessandro Ranellucci|Henrik Brix Andersen|Nicolas Dandrimont|Mark Hindess|Petr Ledvina|Joseph Lenox|Y. Sapir|Mike Sheldrake|Vojtech Bubnik")
    message(FATAL_ERROR "Inherited contributor credits must not appear in the product About page or startup splash.")
endif()
foreach(product_text IN ITEMS "${about_product}" "${splash_credits}")
    string(FIND "${product_text}" "Developed by Infiltrator Projects." developer_start)
    if(developer_start LESS 0)
        message(FATAL_ERROR "About and startup must identify Infiltrator Projects as the developer.")
    endif()
endforeach()
foreach(notice IN ITEMS "2016-2026 Prusa Research" "2011-2018 Alessandro Ranellucci")
    string(FIND "${about_source}" "${notice}" notice_start)
    if(notice_start LESS 0 OR NOT notice_start LESS about_start)
        message(FATAL_ERROR "Preserve inherited copyright notices in Portions copyright: ${notice}")
    endif()
endforeach()
message(STATUS "Slicer ${release_version}; engine compatibility ${SLIC3R_COMPATIBILITY_VERSION}")

file(READ "${repo_root}/LICENSE" project_license)
if(NOT project_license MATCHES "GNU GENERAL PUBLIC LICENSE" OR
   NOT project_license MATCHES "Version 3, 29 June 2007")
    message(FATAL_ERROR "Retain the standard GPLv3 project licence in LICENSE.")
endif()
